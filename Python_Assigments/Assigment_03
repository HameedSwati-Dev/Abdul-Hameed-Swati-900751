# Q22. Set Operations
a = {1, 2, 3, 4, 5}
b = {4, 5, 6, 7, 8}
union_val = a | b
intersection_val = a & b
difference_val = a - b
symmetric_diff = a ^ b
print("Union:", union_val)
print("Intersection:", intersection_val)
print("A - B:", difference_val)
print("Symmetric Difference:", symmetric_diff)

