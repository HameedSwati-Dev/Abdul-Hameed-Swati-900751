# Q27. Three-Set Analysis
python = {"Ali", "Sara", "Ahmed", "Zain"}
sql = {"Sara", "Ahmed", "Hamza"}
aws = {"Ahmed", "Zain", "Hamza"}
in_all_three = python & sql & aws
python_and_sql_only = (python & sql) - aws
at_least_two = (python & sql) | (python & aws) | (sql & aws)
print("In all three:", in_all_three)
print("Python and SQL only (not AWS):", python_and_sql_only)
print("At least two courses:", at_least_two)

# Q28. Transaction Analysis
day1 = {101, 102, 103, 104}
day2 = {103, 104, 105, 106}
day3 = {104, 106, 107, 108}
all_days = day1 & day2 & day3
pairs = (day1 & day2) | (day2 & day3) | (day1 & day3)
union_all = day1 | day2 | day3
exactly_one_day = union_all - pairs
at_least_two_days = pairs
print("Appearing on all days:", all_days)
print("Appearing on exactly one day:", exactly_one_day)
print("Appearing on at least two days:", at_least_two_days)

# Q29. Access Control
required_permissions = {"read", "write", "execute"}
user_permissions = {"read", "write", "delete"}
missing_perms = required_permissions - user_permissions
extra_perms = user_permissions - required_permissions
is_authorized = required_permissions.issubset(user_permissions)
print("Missing permissions:", missing_perms)
print("Extra permissions:", extra_perms)
print("Full authorization status:", is_authorized)

# Q30. Customer Segmentation
website = {"C1", "C2", "C3", "C4", "C5"}
mobile = {"C3", "C4", "C6", "C7"}
store = {"C2", "C4", "C7", "C8"}
all_platforms = website | mobile | store
pairs = (website & mobile) | (mobile & store) | (website & store)
all_three = website & mobile & store
exactly_one_platform = all_platforms - pairs
exactly_two_platforms = pairs - all_three
all_three_platforms = all_three
print("Exactly one platform:", exactly_one_platform)
print("Exactly two platforms:", exactly_two_platforms)
print("All three platforms:", all_three_platforms)
