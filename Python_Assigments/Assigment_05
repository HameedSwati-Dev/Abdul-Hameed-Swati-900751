    (accounts["A102"]["transactions"][1] if accounts["A102"]["transactions"][1] < 0 else 0) +
    (accounts["A102"]["transactions"][2] if accounts["A102"]["transactions"][2] < 0 else 0)
)
ahmed_withdrawals = (
    accounts["A103"]["transactions"][1] if accounts["A103"]["transactions"][1] < 0 else 0
)
total_withdrawals = abs(ali_withdrawals + sara_withdrawals + ahmed_withdrawals)

all_deposits = (
    [accounts["A101"]["transactions"][0], accounts["A101"]["transactions"][2]] +
