highest_balance_holder = max(final_balances, key=final_balances.get)

ali_withdrawals = (
    (accounts["A101"]["transactions"][1] if accounts["A101"]["transactions"][1] < 0 else 0) +
    (accounts["A101"]["transactions"][3] if accounts["A101"]["transactions"][3] < 0 else 0)
)
