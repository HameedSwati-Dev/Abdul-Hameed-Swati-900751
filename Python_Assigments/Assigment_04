# Q40. Inventory Management
inventory = {
    "P101": {"name": "Laptop", "price": 120000, "stock": 5},
    "P102": {"name": "Mouse", "price": 1500, "stock": 20},
    "P103": {"name": "Keyboard", "price": 3500, "stock": 10}
}
val_laptop = inventory["P101"]["price"] * inventory["P101"]["stock"]
val_mouse = inventory["P102"]["price"] * inventory["P102"]["stock"]
val_keyboard = inventory["P103"]["price"] * inventory["P103"]["stock"]
total_inventory_val = val_laptop + val_mouse + val_keyboard

item_values = {
    inventory["P101"]["name"]: val_laptop,
    inventory["P102"]["name"]: val_mouse,
    inventory["P103"]["name"]: val_keyboard
}
most_valuable_item = max(item_values, key=item_values.get)

inventory["P101"]["stock"] -= 2
inventory["P102"]["stock"] -= 5

print("Total Inventory Value:", total_inventory_val)
print("Most Valuable Item by Price x Stock:", most_valuable_item)
print("Updated Inventory Stock:", inventory)
