# Q13. Tuple Concatenation
tuple1 = (10, 20, 30)
tuple2 = (40, 50, 60)
combined_tuple = tuple1 + tuple2
reversed_tuple = combined_tuple[::-1]
print("Combined:", combined_tuple)
print("Reversed:", reversed_tuple)

