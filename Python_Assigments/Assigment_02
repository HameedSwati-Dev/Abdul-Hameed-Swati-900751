print("Last:", last)

# Q16. Modify an Immutable Tuple
numbers_q16 = (10, 20, 30, 40, 50)
new_tuple = numbers_q16[:2] + (300,) + numbers_q16[3:]
print("New Tuple:", new_tuple)

# Q17. Nested Tuple Access
students = (
    ("Ali", (85, 90, 88)),
    ("Sara", (92, 87, 95)),
    ("Ahmed", (78, 84, 80))
)
sara_second_score = students[1][1][1]
ali_average = sum(students[0][1]) / len(students[0][1])
ahmed_highest = max(students[2][1])
print("Sara's Second Score:", sara_second_score)
print("Ali's Average:", ali_average)
print("Ahmed's Highest Score:", ahmed_highest)

# Q18. Tuple Sorting
from operator import itemgetter
employees = (
    ("Ali", 80000),
    ("Sara", 120000),
    ("Ahmed", 95000)
)
sorted_employees = tuple(sorted(employees, key=itemgetter(1), reverse=True))
print("Sorted Employees (Descending):", sorted_employees)

# Q19. Tuple Matrix
import math

matrix = ((2, 4, 6), (8, 10, 12), (14, 16, 18))
diagonal = (matrix[0][0], matrix[1][1], matrix[2][2])
diagonal_product = math.prod(diagonal)
row_sums = (sum(matrix[0]), sum(matrix[1]), sum(matrix[2]))
print("Diagonal:", diagonal)
print("Product of Diagonal:", diagonal_product)
print("Row Sums:", row_sums)

# Q20. Inventory Tuple Challenge
records = (
    ("Laptop", 120000, 5),
    ("Mouse", 1500, 20),
    ("Keyboard", 3500, 10)
)
total_inventory_value = (
    (records[0][1] * records[0][2]) +
    (records[1][1] * records[1][2]) +
    (records[2][1] * records[2][2])
)
most_expensive = max(records, key=itemgetter(1))[0]
names_tuple = (records[0][0], records[1][0], records[2][0])
reversed_names = names_tuple[::-1]
print("Total Inventory Value:", total_inventory_value)
print("Most Expensive Product:", most_expensive)
print("Reversed Names Tuple:", reversed_names)
