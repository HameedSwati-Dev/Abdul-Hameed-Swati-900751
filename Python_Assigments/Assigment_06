import json
import os

DB_FILE = "contacts.json"

def load_contacts():
    if not os.path.exists(DB_FILE):
        return []
    try:
        with open(DB_FILE, "r", encoding="utf-8") as f:
            return json.load(f)
    except json.JSONDecodeError:
        print("Warning: Corrupted JSON file found. Starting fresh safely.")
        return []

def save_contacts(contacts):
    temp_file = DB_FILE + ".tmp"
    with open(temp_file, "w", encoding="utf-8") as f:
        json.dump(contacts, f, indent=4)
    os.replace(temp_file, DB_FILE)

def add_contact(cid, name, phone, email):
    contacts = load_contacts()
    if any(c["id"] == cid for c in contacts):
        print("Error: Contact ID already exists.")
        return
    contacts.append({"id": cid, "name": name, "phone": phone, "email": email})
    save_contacts(contacts)
    print("Contact added successfully!")

def search_contacts(query):
    contacts = load_contacts()
    q = query.lower()
    return [c for c in contacts if q in c["name"].lower()]

def list_contacts():
    return load_contacts()
#Task 15: Integrated Order Fulfillment System
import json
import os
import unittest

class Product:
    def __init__(self, pid, name, price, stock):
        self.pid = pid
        self.name = name
        self.price = float(price)
        self.stock = int(stock)

class Cart:
    def __init__(self):
        self.items = {}

    def add_item(self, product, quantity):
        if quantity <= 0:
            raise ValueError("Quantity must be positive")
        self.items[product] = self.items.get(product, 0) + quantity

    def calculate_total(self, discount_pct=0):
        subtotal = sum(p.price * qty for p, qty in self.items.items())
        return subtotal * (1 - discount_pct / 100.0)

class Inventory:
    def __init__(self, catalog_path):
        self.catalog_path = catalog_path
        self.products = {}
        self.load_catalog()

    def load_catalog(self):
        if os.path.exists(self.catalog_path):
            with open(self.catalog_path, "r") as f:
                data = json.load(f)
                for item in data:
                    p = Product(item["id"], item["name"], item["price"], item["stock"])
                    self.products[p.pid] = p

    def validate_cart(self, cart):
        for prod, qty in cart.items.items():
            if prod.pid not in self.products:
                raise ValueError(f"Product {prod.name} not in catalog")
            if self.products[prod.pid].stock < qty:
                raise ValueError(f"Insufficient stock for {prod.name}")

    def deduct_stock(self, cart):
        for prod, qty in cart.items.items():
            self.products[prod.pid].stock -= qty

# --- Unit Tests ---
class TestFulfillment(unittest.TestCase):
    def test_cart_total(self):
        p1 = Product("P1", "Item 1", 100, 10)
        cart = Cart()
        cart.add_item(p1, 2)
        self.assertEqual(cart.calculate_total(10), 180.0)

    def test_invalid_qty(self):
        cart = Cart()
        p1 = Product("P1", "Item 1", 100, 10)
        with self.assertRaises(ValueError):
            cart.add_item(p1, -1)

    def test_stock_deduction(self):
        inv = Inventory("dummy.json")
        p1 = Product("P1", "Item 1", 100, 5)
        inv.products["P1"] = p1
        cart = Cart()
        cart.add_item(p1, 2)
        inv.deduct_stock(cart)
        self.assertEqual(p1.stock, 3)
