import csv

def process_gradebook(students_file, scores_file, report_file):
    students = {}
    with open(students_file, "r", encoding="utf-8") as f:
        reader = csv.DictReader(f)
        for row in reader:
            students[row["student_id"]] = row["name"]

    scores = {}
    seen_entries = set()

    with open(scores_file, "r", encoding="utf-8") as f:
        reader = csv.DictReader(f)
        for row in reader:
            s_id = row["student_id"]
            subj = row["subject"]
            marks = float(row["marks"])

            if s_id not in students:
                continue

            if not (0 <= marks <= 100):
                continue

            key = (s_id, subj)
            if key in seen_entries:
                continue
            seen_entries.add(key)

            if s_id not in scores:
                scores[s_id] = []
            scores[s_id].append(marks)

    records = []
    for s_id, s_marks in scores.items():
        avg = sum(s_marks) / len(s_marks)
        if avg >= 85: grade = "A"
        elif avg >= 70: grade = "B"
        elif avg >= 55: grade = "C"
        elif avg >= 40: grade = "D"
        else: grade = "F"

        records.append({
            "student_id": s_id,
            "name": students[s_id],
            "average": round(avg, 2),
            "grade": grade
        })

    records.sort(key=lambda x: (-x["average"], x["student_id"]))

    for r_idx, rec in enumerate(records, start=1):
        rec["rank"] = r_idx

    with open(report_file, "w", newline="", encoding="utf-8") as f:
        fieldnames = ["student_id", "name", "average", "grade", "rank"]
        writer = csv.DictWriter(f, fieldnames=fieldnames)
        writer.writeheader()
        writer.writerows(records)
#Task 12: Custom Iterable Range Toolkit
class ReversibleRange:
    def __init__(self, start, stop=None, step=1):
        if stop is None:
            self.start = 0
            self.stop = start
        else:
            self.start = start
            self.stop = stop

        if step == 0:
            raise ValueError("ReversibleRange step argument must not be zero")
        self.step = step

    def __len__(self):
        if self.step > 0 and self.start < self.stop:
            return (self.stop - self.start - 1) // self.step + 1
        elif self.step < 0 and self.start > self.stop:
            return (self.start - self.stop - 1) // (-self.step) + 1
        return 0

    def __iter__(self):
        curr = self.start
        if self.step > 0:
            while curr < self.stop:
                yield curr
                curr += self.step
        else:
            while curr > self.stop:
                yield curr
                curr += self.step

    def __reversed__(self):
        length = len(self)
        if length == 0:
            return
        last = self.start + (length - 1) * self.step
        curr = last
        rev_step = -self.step
        for _ in range(length):
            yield curr
            curr += rev_step

    def __contains__(self, item):
        if not isinstance(item, int):
            return False
        if self.step > 0:
            if not (self.start <= item < self.stop):
                return False
        else:
            if not (self.stop < item <= self.start):
                return False
        return (item - self.start) % self.step == 0
#Task 13: Booking Conflict Scheduler
from datetime import datetime

class RoomScheduler:
    def __init__(self):
        self.bookings = {}
        self.booking_ids = set()

    def add_booking(self, booking_id, room, start_dt, end_dt):
        if booking_id in self.booking_ids:
            return False, "Duplicate booking ID"

        if end_dt <= start_dt:
            return False, "End time must be after start time"

        if room not in self.bookings:
            self.bookings[room] = []

        for b in self.bookings[room]:
            if b["start"] < end_dt and b["end"] > start_dt:
                return False, f"Conflict with booking {b['id']}"

        self.booking_ids.add(booking_id)
        self.bookings[room].append({
            "id": booking_id,
            "start": start_dt,
            "end": end_dt
        })
        return True, "Booking accepted"
